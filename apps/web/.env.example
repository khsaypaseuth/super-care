# super-care / apps/web — environment variable template
# Copy to .env and fill in real values. NEVER commit .env.
#
# Required for the server to start:
#   DATABASE_URL, MASTER_KEY_CURRENT, MASTER_KEY_V1, INDEX_KEY
#
# Optional adapter config (defaults shown — change only for Phase 10 real adapters):
#   OCR_PROVIDER, MAPPER_PROVIDER, STORAGE_PROVIDER, UPLOAD_DIR

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma 7 does NOT auto-load .env — Next loads it for app).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Used by integration tests (vitest.integration.config.ts) — safe to be a separate DB.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_test?schema=public

# ─── Encryption keys (T-02-01 — no key literals in code) ─────────────────────
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# MUST be exactly 32 bytes base64-encoded (AES-256).
MASTER_KEY_CURRENT=1
MASTER_KEY_V1=REPLACE_WITH_32_BYTE_BASE64_KEY

# Separate HMAC key for blind-index (MUST differ from master key).
INDEX_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ─── Adapter config (03-03 — OCR / Mapper / Storage seams) ──────────────────
# Phase 3: fake/localfs adapters. Phase 10: set to real provider names.
# Do NOT include secrets here — these are config flags only.

# OCR adapter selector: "fake" (Phase 3 default) | "google" (Phase 10 Google Document AI)
OCR_PROVIDER=fake

# Mapper adapter selector: "fake" (Phase 3 default) | "llm" (Phase 10 Claude/GPT)
MAPPER_PROVIDER=fake

# Storage adapter selector: "localfs" (Phase 3 default) | "s3" (Phase 10 S3/R2/Hostinger)
STORAGE_PROVIDER=localfs

# Local filesystem storage directory (localfs adapter only).
# Must be outside public/ and web root. Default: ./.uploads (gitignored).
UPLOAD_DIR=./.uploads
