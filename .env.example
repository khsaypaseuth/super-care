# super-care environment variable template
# Copy to .env (gitignored) and populate with REAL values before running.
# See .planning/phases/02-encrypted-data-layer-audit-spine/USER-SETUP.md for instructions.
# NEVER commit real secrets to this file — placeholders only.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the development database.
# Create with: createdb super_care_dev (after provisioning super_care role)
DATABASE_URL=postgresql://super_care:<password>@localhost:5432/super_care_dev?schema=public

# PostgreSQL connection string for the integration test database (separate from dev).
# Create with: createdb super_care_test
TEST_DATABASE_URL=postgresql://super_care:<password>@localhost:5432/super_care_test?schema=public

# ─── Encryption keys ─────────────────────────────────────────────────────────
# AES-256 master encryption key for PII fields at rest (32 bytes, base64-encoded).
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
MASTER_KEY_V1=<base64-encoded-32-bytes>

# Active key version (integer, matches MASTER_KEY_V{n} above).
# Increment this (and add MASTER_KEY_V2, etc.) during key rotation.
MASTER_KEY_CURRENT=1

# HMAC blind-index key for searchable-PII companion columns (separate from master key).
# MUST be a different 32-byte secret — see 02-CONTEXT.md locked decisions.
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
INDEX_KEY=<base64-encoded-32-bytes>
